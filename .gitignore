# ---------------------------------------------------------------------------
# Patient data — never commit.
#
# Scored results carry subject identifiers (folder/MRN, initials, and dates of
# service embedded in file paths). Standardized image dirs contain face images.
# Both are PHI under HIPAA Safe Harbor even after de-identification, because
# facial images are themselves an enumerated identifier.
# ---------------------------------------------------------------------------
scripts/results.csv
scripts/logs/
# (the redacted summary IS committed; the raw report is not)
scripts/reference/validation-report.raw.json
*_standardized/
_deid_qa/
attached_assets/
photos/
Photos/
*.phi.csv

# macOS
.DS_Store
