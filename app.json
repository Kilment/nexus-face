{
  "expo": {
    "name": "FaceSnap",
    "slug": "facesnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "facesnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.facesnap.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FaceSnap needs camera access to capture photos for face processing.",
        "NSPhotoLibraryUsageDescription": "FaceSnap needs photo library access to upload images for processing."
      }
    },
    "android": {
      "package": "com.facesnap.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "FaceSnap needs camera access to capture photos for face processing."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FaceSnap needs photo library access to upload images for processing."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
