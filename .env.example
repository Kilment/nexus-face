# Copy to .env.local and fill in. .env and .env.local are gitignored.
# Never commit real keys.

# ---------------------------------------------------------------------------
# Required — image standardization and in-app pair scoring (OpenAI)
# ---------------------------------------------------------------------------
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional: point at a proxy or gateway. Leave blank for the default endpoint.
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Required for the batch research scorer (scripts/score_pairs.py)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model pinning
#
# Always a DATED SNAPSHOT, never a floating alias. An alias silently re-points
# to a new model, which shifts every score and invalidates any cohort reference
# built under the old one. Changing either value means rebuilding the reference.
# ---------------------------------------------------------------------------
COHORT_VISION_MODEL=gpt-4o-2024-11-20
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---------------------------------------------------------------------------
# Required only for the mobile app / server (not for the research pipeline)
# ---------------------------------------------------------------------------
DATABASE_URL=
SESSION_SECRET=
PORT=5000

# ---------------------------------------------------------------------------
# Optional — demographic attributes (AWS Rekognition)
#
# Without these, gender and age range are recorded as N/A. Nothing is guessed.
# Rekognition does not return race or ethnicity, and this pipeline stores no
# such field. See migrations/0002_drop_fabricated_ethnicity.sql.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Path to the frozen cohort reference (default: scripts/reference/cohort-reference.json)
COHORT_REFERENCE_PATH=
# Fail startup if bundled face-detection model checksums do not match.
DEID_STRICT_MODEL_CHECKSUMS=
DEID_MODEL_SHA256_JSON=
