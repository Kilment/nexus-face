# Copy to .env.local and fill in. .env and .env.local are gitignored.
# Never commit real keys.

# ---------------------------------------------------------------------------
# Required — pair scoring, for both the research pipeline and the mobile app.
#
# Both paths use Anthropic so that scores are comparable against the shipped
# cohort reference. There is no OpenAI dependency anywhere in the pipeline.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model pinning.
#
# MUST be a dated snapshot, and MUST match the model that built the cohort
# reference you are scoring against (see scripts/reference/cohort-reference.json,
# field "modelId"). On mismatch every composite returns N/A by design, because
# z-scoring one model's output against another's distribution is meaningless.
#
# Undated aliases (claude-opus-5, claude-sonnet-5, ...) silently re-point to a
# new model and invalidate the reference. The pipeline warns if you use one.
#
# Changing this means rebuilding the reference.
# ---------------------------------------------------------------------------
COHORT_VISION_MODEL=claude-opus-4-5-20251101
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# ---------------------------------------------------------------------------
# Required only for the mobile app / server. The research pipeline needs none.
# ---------------------------------------------------------------------------
DATABASE_URL=
PORT=5000

# Must equal the iOS bundle identifier registered with Apple. Sign in with
# Apple identity tokens are rejected unless their audience matches this, so a
# wrong value silently blocks all sign-ins.
APPLE_BUNDLE_ID=

# Public origin the app calls, e.g. api.example.com (no scheme).
EXPO_PUBLIC_DOMAIN=

# ---------------------------------------------------------------------------
# Optional — demographic attributes (AWS Rekognition).
#
# Without these, gender and age range are recorded as N/A. Nothing is guessed.
# Rekognition does not return race or ethnicity, and this pipeline stores no
# such field. See migrations/0002_drop_fabricated_ethnicity.sql.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional overrides.
# ---------------------------------------------------------------------------
# Path to the frozen cohort reference (default: scripts/reference/cohort-reference.json)
COHORT_REFERENCE_PATH=
# Fail startup if bundled face-detection model checksums do not match.
DEID_STRICT_MODEL_CHECKSUMS=
DEID_MODEL_SHA256_JSON=
